<?xml version="1.0" encoding="UTF-8"?>
<web-app version="6.0" xmlns="https://jakarta.ee/xml/ns/jakartaee" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd">
    <servlet>
        <servlet-name>ProsesPeminjaman</servlet-name>
        <servlet-class>ProsesPeminjaman</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProsesLogin</servlet-name>
        <servlet-class>ProsesLogin</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProsesPengembalian</servlet-name>
        <servlet-class>ProsesPengembalian</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>HapusPeminjaman</servlet-name>
        <servlet-class>HapusPeminjaman</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProsesPeminjaman</servlet-name>
        <url-pattern>/ProsesPeminjaman</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProsesLogin</servlet-name>
        <url-pattern>/ProsesLogin</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProsesPengembalian</servlet-name>
        <url-pattern>/ProsesPengembalian</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HapusPeminjaman</servlet-name>
        <url-pattern>/HapusPeminjaman</url-pattern>
    </servlet-mapping>
    <session-config>
        <session-timeout>
            30
        </session-timeout>
    </session-config>
</web-app>
